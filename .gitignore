# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# Logs
*.log
logs/
*.pid
*.seed
*.patch

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.example # Keep .env.example for reference, but ignore actual .env files

# Build artifacts
# Client-side (React) build output
client/build/
client/dist/

# Server-side build output (if any, e.g., TypeScript compilation)
server/build/
server/dist/

# Dependency directories (explicitly for sub-projects if not covered by root node_modules)
# Although `node_modules/` at the root covers these, being explicit can sometimes help clarity
# client/node_modules/
# server/node_modules/

# Test coverage
coverage/
.nyc_output/

# Editor/IDE specific
.vscode/
.idea/
*.swp
*.swo
*.bak
*.orig
*.rej

# OS specific
.DS_Store
Thumbs.db

# Other temporary files
*.tmp
*.temp
*.cache
.eslintcache
.prettiercache